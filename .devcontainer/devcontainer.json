{
  "name": "AGROLEITE",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "AGROLEITE",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install",
  "postAttachCommand": "echo 'Rode: npm start  →  depois abra a porta 3000'",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
